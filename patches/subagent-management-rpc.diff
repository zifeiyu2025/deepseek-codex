+    pub(crate) async fn thread_subagents_list(
+        &self,
+        params: ThreadSubagentsListParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let agents = thread
+            .list_subagents(params.path_prefix.as_deref())
+            .await
+            .map_err(|err| internal_error(format!("failed to list subagents: {err}")))?;
+        let response = ThreadSubagentsListResponse {
+            agents: agents
+                .into_iter()
+                .map(|agent| {
+                    subagent_info_from_parts(
+                        agent.thread_id,
+                        agent.metadata,
+                        Some(agent.status),
+                    )
+                })
+                .collect(),
+        };
+        Ok(Some(response.into()))
+    }
+
+    pub(crate) async fn thread_subagents_interrupt(
+        &self,
+        params: ThreadSubagentsInterruptParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let agent_thread_id = ThreadId::from_string(&params.agent_thread_id)
+            .map_err(|err| invalid_request(format!("invalid agent thread id: {err}")))?;
+        let info = thread
+            .interrupt_subagent(agent_thread_id)
+            .await
+            .map_err(|err| internal_error(format!("failed to interrupt subagent: {err}")))?;
+        let agent = match info {
+            codex_core::AgentInfo::Loaded { agent, .. } => {
+                subagent_info_from_parts(agent.thread_id, agent.metadata, Some(agent.status))
+            }
+            codex_core::AgentInfo::Unloaded(metadata) => {
+                subagent_info_from_parts(agent_thread_id, metadata, None)
+            }
+        };
+        Ok(Some(ThreadSubagentsInterruptResponse { agent }.into()))
+    }
