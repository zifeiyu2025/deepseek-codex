+fn subagent_info_from_parts(
+    thread_id: ThreadId,
+    metadata: codex_core::AgentMetadata,
+    status: Option<AgentStatus>,
+) -> SubagentInfo {
+    let (status, status_detail) = match status {
+        Some(AgentStatus::PendingInit) => (SubagentStatus::PendingInit, None),
+        Some(AgentStatus::Running) => (SubagentStatus::Running, None),
+        Some(AgentStatus::Interrupted) => (SubagentStatus::Interrupted, None),
+        Some(AgentStatus::Completed(message)) => (SubagentStatus::Completed, message),
+        Some(AgentStatus::Errored(message)) => (SubagentStatus::Errored, Some(message)),
+        Some(AgentStatus::Shutdown) => (SubagentStatus::Shutdown, None),
+        Some(AgentStatus::NotFound) => (SubagentStatus::NotFound, None),
+        None => (SubagentStatus::Unloaded, None),
+    };
+    SubagentInfo {
+        thread_id: thread_id.to_string(),
+        agent_path: metadata
+            .agent_path
+            .map(|path| path.as_str().to_string()),
+        nickname: metadata.agent_nickname,
+        role: metadata.agent_role,
+        status,
+        status_detail,
+    }
+}
