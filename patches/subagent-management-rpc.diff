+    /// Lists live agents in this thread's agent tree, excluding the caller itself.
+    pub async fn list_subagents(&self, path_prefix: Option<&str>) -> CodexResult<Vec<LiveAgent>> {
+        let mut agents = self
+            .session
+            .services
+            .agent_control
+            .list(
+                self.session.thread_id,
+                self.session_source.parent_thread_id(),
+                &self.session_source,
+                path_prefix,
+            )
+            .await?;
+        agents.retain(|agent| agent.thread_id != self.session.thread_id);
+        Ok(agents)
+    }
+
+    /// Interrupts a child agent in this thread's agent tree.
