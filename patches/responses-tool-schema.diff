+/// Removes the OpenAI-only `encrypted` tool-parameter marker.
+///
+/// Responses-compatible third-party providers accept the surrounding JSON Schema
+/// but do not implement OpenAI's encrypted tool-argument extension. Leaving the
+/// marker in place can cause required encrypted parameters to be omitted by the
+/// model, so non-OpenAI providers should receive the plain schema.
+pub fn strip_encrypted_tool_markers(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            map.remove("encrypted");
+            for child in map.values_mut() {
+                strip_encrypted_tool_markers(child);
+            }
+        }
+        Value::Array(items) => {
+            for item in items {
+                strip_encrypted_tool_markers(item);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Returns raw JSON for Responses-compatible providers that do not support the
+/// OpenAI `encrypted` tool-parameter extension.
+pub fn create_tools_raw_json_for_responses_compatible_provider(
+    tools: &[ToolSpec],
+) -> Result<Arc<RawValue>, serde_json::Error> {
+    let mut value = serde_json::to_value(tools)?;
+    strip_encrypted_tool_markers(&mut value);
+    serde_json::value::to_raw_value(&value).map(Arc::from)
+}
