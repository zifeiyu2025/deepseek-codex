{
  "name": "deepseek-codex-gui",
  "version": "0.45.53",
  "private": true,
  "description": "Independent desktop GUI for the locally built Codex app-server, defaulting to DeepSeek.",
  "author": "local",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test:smoke:auto",
    "start": "npm run build && electron .",
    "app": "electron .",
    "test:smoke": "node scripts/e2e-smoke.cjs",
    "test:smoke:auto": "node scripts/run-smoke.cjs",
    "test:computer": "node scripts/verify-computer-tools.cjs",
    "test:packaged": "node scripts/verify-packaged.cjs",
    "clean:release": "node scripts/clean-release.cjs",
    "dist:win": "npm run build && node scripts/prepare-engine.cjs && electron-builder --win portable"
  },
  "build": {
    "appId": "local.deepseek.codex",
    "productName": "DeepSeek Codex",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/node-pty/prebuilds/darwin-*/**/*",
      "!node_modules/node-pty/prebuilds/win32-arm64/**/*",
      "!node_modules/node-pty/deps/**/*",
      "!node_modules/node-pty/src/**/*",
      "!node_modules/node-pty/third_party/**/*",
      "!node_modules/node-pty/build/**/*"
    ],
    "extraResources": [
      {
        "from": "codex.exe",
        "to": "codex/codex.exe"
      },
      {
        "from": "mcp",
        "to": "mcp"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/win32-x64/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DeepSeek-Codex-${version}.exe"
    }
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.77.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
